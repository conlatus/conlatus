{
  "name": "conlatus-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "backend": "node scripts/py.js -m uvicorn main:app --reload --port 8000 --app-dir backend",
    "frontend": "npm --prefix frontend run dev",
    "dev": "npm --prefix frontend run dev",
    "test:backend": "node scripts/py.js -m pytest backend/tests",
    "build:frontend": "npm --prefix frontend run build",
    "lint:frontend": "npm --prefix frontend run lint"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "framer-motion": "^12.43.0",
    "i": "^0.3.7",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "npm": "^11.19.0",
    "ogl": "^1.0.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  }
}
